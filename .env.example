# Required to collect Regulations.gov comments
REGULATION_API_KEY=

# Required when ai.provider is openrouter
OPENROUTER_API_KEY=

# Optional shared workbook (recommended). Notice rows use the main tab and each
# notice's comments use their own tab in this workbook.
GRAIL_SHEET_URL=

# Optional per-pipeline overrides when separate workbooks are desired
NOTICE_SHEET_URL=
COMMENT_SHEET_URL=

# Optional; generated in memory when omitted. Set a stable value for the web UI.
GRAIL_WEB_SECRET=
